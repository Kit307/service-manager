{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Service Manager Console QA",
  "version": "0.6.3",
  "identifier": "dev.servicemanager.consoleqa063",
  "build": {
    "frontendDist": "/Users/krit/Documents/Codex/2026-10-16/new-chat/service-manager/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Service Manager",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "minimizable": false,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "/Users/krit/Documents/Codex/2026-10-16/new-chat/service-manager/src-tauri/icons/icon.png",
      "/Users/krit/Documents/Codex/2026-10-16/new-chat/service-manager/src-tauri/icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
